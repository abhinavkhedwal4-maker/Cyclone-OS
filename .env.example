# Copy to .env and fill in your project values.
# Never commit real keys. The anon key is safe for the browser (RLS still applies).

# Supabase — from Project Settings → API
# Use the base URL only — do NOT append /rest/v1 or any path suffix.
# CORRECT:   https://xxxx.supabase.co
# WRONG:     https://xxxx.supabase.co/rest/v1
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Only for `npm run gee:ingest` (server-side script, never sent to the browser).
# Project Settings → API → service_role. Do NOT prefix this with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Earth Engine — server-side only (never prefix with VITE_)
# Service account email from GCP IAM, e.g. cyclone-os@delta-surface-494916-d0.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_EMAIL=
# Contents of your service account JSON private_key field — keep \n as literal \\n
GEE_PRIVATE_KEY=
# GCP project ID that has Earth Engine API enabled
GEE_PROJECT_ID=delta-surface-494916-d0

# Optional. If set, advisory Generate uses Gemini first.
# Suggested model id: gemini-2.5-flash  (set gemini-3.7-flash if your project has it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
